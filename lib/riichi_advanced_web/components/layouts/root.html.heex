<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script>window.userToken = "<%= assigns[:user_token] %>";</script>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}></script>

    <title>Riichi Advanced</title>
    <meta name="description" content="Infinitely extensible mahjong web client -- play Riichi, Hong Kong Old Style, Taiwanese, Sichuan Bloody, Space Mahjong, MCR, and more" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="Riichi Advanced" />
    <meta property="og:site_name" content="Riichi Advanced" />
    <meta property="og:description" content="Infinitely extensible mahjong web client -- play Riichi, Hong Kong Old Style, Taiwanese, Sichuan Bloody, Space Mahjong, MCR, and more" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Riichi Advanced" />
    <meta name="twitter:description" content="Infinitely extensible mahjong web client -- play Riichi, Hong Kong Old Style, Taiwanese, Sichuan Bloody, Space Mahjong, MCR, and more" />
  </head>
  <body class="bg-black">
    <%= @inner_content %>
  </body>
</html>
